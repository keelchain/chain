# One entry per network; the header switcher lists them in this order.
# `api` is the indexer, `rpc` the node RPC (defaults to `/rpc` next to `/api`).
VITE_NETWORKS='[{"id":"testnet","name":"Testnet","api":"http://127.0.0.1:6100","rpc":"http://127.0.0.1:5100"}]'
# Where "Explorer" links point; the network id is appended as the first path segment.
VITE_EXPLORER_URL=http://127.0.0.1:5177
# Set to 1 to serve a demo client from the in-browser mock (no node, no wallet).
VITE_API_MOCK=0
