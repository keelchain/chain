# Rendered by deploy-remote.sh into /etc/keelchain/observer-N.toml (root, 0600).
keel_rpc_url = "http://127.0.0.1:@RPC_PORT@"
tss_url = "@TSS_URL@"
state_file = "/var/lib/keelchain/observer-@N@.json"

[intervals]
sync_secs = 30
deposits_secs = 20
outbound_secs = 15
fees_secs = 300

[bitcoin]
rpc_url = "@BITCOIN_RPC_URL@"
rpc_user = "@BITCOIN_RPC_USER@"
rpc_password = "@BITCOIN_RPC_PASSWORD@"
network = "@EXTERNAL_NETWORK@"
wallet = "@BITCOIN_WALLET@"
max_proof_headers = 144
fee_target_blocks = 2
fallback_sat_per_vb = 2

# BNB Smart Chain (attestation only, like Tron): the same key path as
# Ethereum, so an account's address is one string on both chains.
[bsc]
rpc_url = "@BSC_RPC_URL@"
network = "@EXTERNAL_NETWORK@"
log_window = 2000
native_scan_blocks = 64
hot_index = 0
tokens = [{ symbol = "USDT", contract = "@BSC_USDT_CONTRACT@" }]

# Solana (attestation only): an Ed25519 vault key signed by FROST (the
# `--scheme eddsa` share of the ceremony; the development signer derives
# one from its seed in local mode).
[solana]
rpc_url = "@SOLANA_RPC_URL@"
network = "@EXTERNAL_NETWORK@"
priority_micro_lamports = 0
signature_limit = 50
hot_index = 0
tokens = [{ symbol = "USDC", contract = "@SOLANA_USDC_MINT@", decimals = 6 }]

[tron]
api_url = "@TRON_API_URL@"
@TRON_API_KEY_LINE@
fee_sun = 15000000
fee_limit_sun = 100000000
hot_index = 0
tokens = [{ symbol = "USDT", contract = "@TRON_USDT_CONTRACT@" }]

[outbound]
enabled = true
leader_timeout_secs = 900
